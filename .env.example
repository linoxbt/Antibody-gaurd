# Antibody Guard: every environment variable, by where it is read.
# Copy what you need to .env (never committed). Secrets are marked SECRET: set them only on the
# machine or service that needs them, never on the static site.

# ---- Guard service (service/, deployed on Railway) ------------------------------------------
PORT=8787                                   # HTTP port
NODE_ENV=production
LOOKBACK_SECONDS=7200                       # how far back the indexer reads at start-up
GUARD_SCORER_KEY=                           # SECRET: testnet key allowed to report on the RiskOracle
GUARD_REGISTRAR_KEY=                        # SECRET: testnet key with GuardReactive's registrar role
                                            #         (may only watch, unwatch and immunize vaults)
LLM_API_KEY=                                # SECRET: model key; without it POST /api/score answers 503
LLM_BASE_URL=https://api.fortytwo.network/v1   # any OpenAI-compatible endpoint
LLM_MODEL=qwen/qwen3.8-27b
LLM_REASONING_EFFORT=low

# ---- Site build (netlify.toml, scripts/build-web.ts, wallet/build.mjs) ----------------------
GUARD_API_ORIGIN=https://antibody-guard-production.up.railway.app   # where /api/* is proxied
REOWN_PROJECT_ID=d1bf7b7232b7d0fb7f0469d0adb29f5b                     # public Reown (WalletConnect) ID
NODE_VERSION=22

# ---- guard CLI (cli/guard.ts) ------------------------------------------------------------------
GUARD_API=https://antibody-guard-reactive.netlify.app   # the site whose /api/watch the CLI calls
GUARD_KEY_DIR=~/.antibody-guard                         # where testnet keys and config.json live
GUARD_OWNER_KEY=                            # SECRET (optional): instead of GUARD_KEY_DIR/owner.key
GUARD_AGENT_KEY=                            # SECRET (optional): instead of GUARD_KEY_DIR/agent.key
GUARD_REACTIVE=                             # optional: a GuardReactive other than v5
GUARD_DEBUG=                                # set to 1 for full error output

# ---- Installer (install.sh) --------------------------------------------------------------------
GUARD_REPO=https://github.com/linoxbt/Antibody-gaurd
GUARD_REF=main
GUARD_APP_DIR=~/.antibody-guard/app
GUARD_BIN_DIR=~/.local/bin

# ---- Deployment scripts (scripts/) -----------------------------------------------------------------
GUARD_DEPLOYER_KEY=                         # SECRET (optional): instead of GUARD_KEY_DIR/deployer.key
GUARD_RECORD=lasna-v5                       # which deployments/*.json a script reads or writes
REACTIVE_MCP_URL=https://mcp.rnk.dev/mcp    # Reactive MCP, for npm run rmcp and guard health
